{
  "name": "@local/obsidian-list-callouts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Renders list callouts (- ! item) in Markdown file previews and Chat messages; a port of the Obsidian List Callouts plugin.",
  "license": "GPL-3.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  }
}
